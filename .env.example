# GEMINI_API_KEY: Optional server-side key for future AI proxy calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_FORM_ENDPOINT: Contact form endpoint (e.g. Formspree, Web3Forms, or /api/contact).
# Leave empty/unset to verify the un-connected honest fallback message.
# VITE_FORM_ENDPOINT="/api/contact"

# CONTACT_WEBHOOK_URL: Optional webhook URL (Slack/Make/Zapier/etc.) to forward /api/contact submissions on Vercel.
# CONTACT_WEBHOOK_URL=""
